# Copy to .env.local for local overrides. Every VITE_* value is public in the browser.
# Production builds read .env.production.local as an optional local override.
VITE_APP_TITLE=Rain-erp
VITE_PORT=5173
VITE_OPEN=false

# Empty base URL uses the same origin; the dev/preview proxy forwards /admin-api.
VITE_BASE_URL=
VITE_API_URL=/admin-api
RAIN_PROXY_TARGET=http://127.0.0.1:48080

# Match these features to the backend configuration.
VITE_APP_TENANT_ENABLE=true
VITE_APP_CAPTCHA_ENABLE=true

# Optional browser-visible map/analytics integrations are disabled by default.
VITE_BAIDU_MAP_KEY=
VITE_APP_BAIDU_CODE=
